{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist/react",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "outDir": "./dist/react",
    "rootDir": "./src/react"
  },
  "include": [
    "src/react/**/*.ts",
    "src/react/**/*.tsx"
  ]
}
